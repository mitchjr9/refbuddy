# ─────────────────────────────────────────────────────────────────────────────
# RefBuddy — secrets template
#
# LOCAL USE:
#   1. Copy this file to .streamlit/secrets.toml  (drop the .template suffix)
#   2. Fill in the real values below
#   3. NEVER commit secrets.toml — it is already in .gitignore
#
# RENDER:
#   Do NOT upload this file. Instead add each key under
#   Render Dashboard → your service → Environment → Environment Variables.
#   Streamlit reads env vars of the same name via st.secrets automatically.
# ─────────────────────────────────────────────────────────────────────────────

# Your Anthropic API key. Get one at https://platform.claude.com
# Required — the app will st.stop() with an error if this is missing.
ANTHROPIC_API_KEY = "sk-ant"

# Shared crew password that gates access to the whole app.
# Required for any public deployment. If you omit this key entirely,
# the password gate is SKIPPED (fine locally, dangerous in production).
# Pick something you can text to your crew but that isn't guessable.
APP_PASSWORD = "PW"